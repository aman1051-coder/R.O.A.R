{
  "name": "ROAR – Rising Oncologists' Alliance in Radiation Oncology",
  "short_name": "ROAR",
  "description": "India's community of radiation oncology residents and young radiation oncologists: education, careers, welfare and ROAR Community.",
  "start_url": "./index.html?source=app",
  "scope": "./",
  "display": "standalone",
  "background_color": "#070c18",
  "theme_color": "#15233f",
  "icons": [
    { "src": "assets/icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "assets/icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "assets/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "favicon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "shortcuts": [
    { "name": "Community", "url": "./portal/#community", "icons": [{ "src": "assets/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Members' area", "url": "./portal/", "icons": [{ "src": "assets/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Events", "url": "./events.html", "icons": [{ "src": "assets/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
